# discord-bot-handoff — copy to ~/.config/discord-bot-handoff/discord.env
# (chmod 600) or point HANDOFF_ENV_FILE at wherever you keep it.
# Both the bot process AND the spawned Claude session source this file.

# ── Discord (required) ────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-bot-token-here
# Only respond to this user id. Leave blank to respond to anyone in watched channels.
# Also required to pass earlier thread messages to Claude.
DISCORD_AUTHORIZED_USER_ID=
# Server id, used by the thread-context skill to search threads by title.
DISCORD_GUILD_ID=
# Comma/space-separated channel or parent-channel ids to watch. Blank = watch all
# channels the bot can see (still gated by DISCORD_AUTHORIZED_USER_ID if set).
WATCHED_CHANNELS=

# ── LLM (any OpenAI-compatible endpoint, local or cloud) ───────────────────
# Change these three to point at any backend — see README "Swapping the LLM endpoint".
# Cloud works too, e.g. https://api.openai.com/v1 or https://openrouter.ai/api/v1
# (the LOCAL_ prefix is historical). No LLM at all? Leave it blank —
# `LOCAL_LLM_BASE_URL=` — and every thread goes straight to Claude.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=local-llm
# Bearer token if your endpoint requires auth (vLLM --api-key, OpenAI, etc.). Blank = none.
LOCAL_LLM_API_KEY=
# Optional tuning:
# LOCAL_LLM_SYSTEM_PROMPT=You are a concise, helpful assistant. Reply in the user's language.
# LOCAL_LLM_MAX_TOKENS=1024
# LOCAL_LLM_TEMPERATURE=0.3
# LOCAL_LLM_TIMEOUT_S=120

# ── Handoff / Claude session (optional overrides) ──────────────────────────
# CLAUDE_BIN=/opt/homebrew/bin/claude        # if `claude` isn't on PATH
# HANDOFF_CWD=/path/to/project               # cwd for the spawned Claude session
# HANDOFF_PROMPT=...{thread_id}...           # override the boot prompt (must keep {thread_id})

# ── State (optional) ───────────────────────────────────────────────────────
# STORE_PATH=~/.local/share/discord-bot-handoff/state.db
# HISTORY_TURNS=8
